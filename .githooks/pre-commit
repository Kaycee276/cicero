#!/usr/bin/env bash
set -e

echo "🛡️  Running Cicero Pre-commit Verification..."

# 1. Secrets & Credentials Detection
bash scripts/check-secrets.sh

# 2. Prettier Formatting Verification
pnpm format:check

# 3. Linter across all workspace packages (core, react, web)
pnpm lint

# 4. Typecheck across all workspace packages (core, react, web)
pnpm typecheck

# 5. Automated Tests across all workspace packages (core, react, web)
pnpm test

echo "✨ All pre-commit checks passed successfully!"
