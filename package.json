    "build:web": "pnpm --filter web build",
    "lint": "pnpm -r lint"
  },
  "keywords": [
    "zcash",
    "shielded-payments",
    "react",
    "web3",
    "crypto-checkout",
    "zip-321",
    "zero-knowledge",
    "cicero"
  ],
