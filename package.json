{
  "name": "cicero-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cicero: The developer payment kit and checkout component for shielded Zcash",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter \"@cicero-zcash/react\" build && pnpm --filter web build",
    "build:core": "pnpm --filter \"@cicero-zcash/core\" build",
    "build:package": "pnpm --filter \"@cicero-zcash/react\" build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:check": "bash scripts/check-secrets.sh",
    "pre-commit": "bash .githooks/pre-commit"
  },
  "devDependencies": {
    "prettier": "^3.5.2"
  },
  "keywords": [
    "zcash",
    "shielded-payments",
    "react",
    "web3",
    "crypto-checkout",
    "zip-321",
    "zero-knowledge",
    "cicero"
  ],
  "author": "Kaycee276",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0"
}
