{
  "name": "@cicero-zcash/core",
  "version": "0.1.0",
  "description": "Framework-agnostic Zcash wallet adapters and payment utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Kaycee276/cicero#readme",
  "bugs": {
    "url": "https://github.com/Kaycee276/cicero/issues"
  },
  "keywords": [
    "zcash",
    "wallet-adapter",
    "zip-321",
    "shielded-payments",
    "zero-knowledge",
    "web3"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').copyFileSync('dist/index.js', 'dist/index.mjs')\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zucchinifi/dapp-sdk": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaycee276/cicero.git",
    "directory": "packages/core"
  },
  "license": "MIT"
}
