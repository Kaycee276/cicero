{
  "name": "@cicero-zcash/react",
  "version": "0.2.8",
  "description": "Universal wallet connection toolkit for shielded Zcash (RainbowKit of Zcash)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "cicero-skill": "bin/init-skill.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "bin",
    "skill",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaycee276/cicero.git",
    "directory": "packages/cicero"
  },
  "homepage": "https://github.com/Kaycee276/cicero#readme",
  "bugs": {
    "url": "https://github.com/Kaycee276/cicero/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "zcash",
    "wallet-adapter",
    "react",
    "rainbowkit",
    "connect-wallet",
    "unified-addresses",
    "zucchini",
    "zashi",
    "ywallet",
    "shielded-zcash"
  ],
  "author": "Kaycee276",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@zucchinifi/dapp-sdk": "^0.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "qrcode.react": "^4.2.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
